# TradeNova production environment template — never commit real secrets
APP_ENV=production
APP_PUBLIC_URL=https://YOUR-DOMAIN.example
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/tradenova
SESSION_SECRET=REPLACE_WITH_32_PLUS_RANDOM_BYTES
TRADENOVA_BOT_TOKEN=
TRADENOVA_ADMIN_IDS=
PAYMENT_PROVIDER=disabled
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
CRYPTO_CUSTODY_PROVIDER=disabled
CRYPTO_API_KEY=
CRYPTO_API_SECRET=
EXCHANGE_PROVIDER=disabled
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
TRADING_LIVE_ENABLED=false
WITHDRAWALS_LIVE_ENABLED=false
